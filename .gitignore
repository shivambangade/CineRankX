# --- Datasets (download separately — see README) ---
# `data/` covers data/processed/ too: the merged frame, TF-IDF matrix, trained
# classifier and the cached SMOTE feature/label frames are all regenerated by
# the ingestion pipeline and the scripts/ verification runs.
data/
newdata/

# --- Model / matrix artifacts, wherever they land ---
*.pkl
*.joblib
*.npz

# --- Generated reports ---
# scripts/generate_kpi_report.py prints to stdout; redirect it here to keep a
# copy without committing run-specific numbers.
reports/

# --- Logs / temp files ---
*.log
*.tmp
tmp/
.tmp_path/

# --- OS junk ---
.DS_Store
Thumbs.db

